# ── .gitignore ────────────────────────────────────────────────────────────────

# Machine-local shell config (contains tokens, proxies, work paths)
stow/shell/.config/shell/local
zsh/.config/zsh/plugins/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor junk
*.swp
*.swo
*~
.idea/
.vscode/

# Test/scratch
scratch/
tmp/

# ignoring gitconfig till there is a solution to a device wise gitconfig
.gitconfig.local
