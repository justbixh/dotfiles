# ~/dotfiles/git/.gitconfig — stowed to ~/.gitconfig
# per-machine identity lives in ~/.gitconfig.local (not tracked)
#[user]
#    name = Bish
#    email = helloatbish@gmail.

[core]
    pager  = delta
    editor = vim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate     = true
    dark         = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula
    hyperlinks   = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[init]
    defaultBranch = main

[alias]
    # Short status
    st = status -sb
    # Pretty log
    lg  = log --graph --decorate --oneline -20
    lga = log --graph --decorate --oneline --all -20
    # Undo last commit, keep changes staged
    undo = reset --soft HEAD~1
    # Show stashes with dates
    stashes = stash list --format="%gd %cd %s" --date=short

[include]
    path = ~/.gitconfig.local
