# ~/dotfiles/git/.config/git/config — stowed to ~/.config/git/config
# NOTE: Pre-existing ~/.gitconfig takes precedence and will override this configuration.
# Per-machine identity should live in ~/.gitconfig.local (included below)
#[user]
#    name = Bish
#    email = helloatbish@gmail.

[include]
    path = ~/.gitconfig.local

[includeIf "gitdir:~/pcc-kubernetes-manifests/"]
    path = ~/.gitconfig.work

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[branch]
	sort = -committerdate

[core]
    colorMoved = default
    pager  = delta
    editor = vim
    # the repo stays with LF line endings only
    autocrlf = input

[interactive]
    diffFilter = delta --color-only

[delta]
    side-by-side = true
    navigate     = true
    dark         = true
    line-numbers = true
    syntax-theme = Dracula
    hyperlinks   = true
    # File header: bold yellow with an underline
    file-style = bold yellow
    file-decoration-style = yellow ul
    file-modified-label = "M:"
    file-added-label = "A:"
    file-removed-label = "D:"
    file-renamed-label = "R:"

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true
    renames = copies
    tool = nvimdiff

[alias]
    # Short status
    st = status -sb
    # Pretty log
    lg  = log --graph --decorate --oneline -20
    lga = log --graph --decorate --oneline --all -20
    # Undo last commit, keep changes staged
    undo = reset --soft HEAD~1
    # Show stashes with dates
    stashes = stash list --format="%gd %cd %s" --date=short

[credential]
	helper = store
