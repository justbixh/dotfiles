# ~/.zshrc
# ── Managed by stow (dotfiles/stow/zsh/.zshrc) ───────────────────────────────
# On WORK machines this file is NOT stowed — instead bootstrap appends a single
# source line to the existing .zshrc. Either way, my.zshrc is what runs.

source ~/.config/zsh/my.zshrc

# Also this is the local zsh where i put my configs as per environments