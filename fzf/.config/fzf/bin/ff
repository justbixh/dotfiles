#!/usr/bin/env bash
# fzf/.config/fzf/bin/ff
# Fuzzy find files and print the picked paths; zsh Ctrl+O / Ctrl+P open them in nvim.
# ff searches the system roots below, ff . only the current directory.
set -euo pipefail

FD=$(command -v fd || command -v fdfind) || { echo "install fd (fd-find)"; exit 1; }
BAT=$(command -v bat || command -v batcat || true)
FILE_ICON=$(printf '\xef\x85\x9b')

# Override per call: FF_ROOTS="$HOME/work:$HOME/notes" ff
if [ -n "${FF_ROOTS:-}" ]; then
  IFS=: read -r -a ROOTS <<< "$FF_ROOTS"
elif [ "$(uname)" = "Darwin" ]; then
  ROOTS=("$HOME" /etc /opt /usr/local /Volumes)
else
  ROOTS=("$HOME" /etc /opt /srv /usr/local /mnt)
fi

# Hidden inside the roots. Plain names match at any depth, paths need the **/ prefix.
EXCLUDES=(
  # VCS and dependencies
  .git node_modules __pycache__ .venv venv
  # Build output
  target build dist out .gradle .idea
  # Caches and package stores
  .cache .m2 .npm .cargo .rustup .sdkman .nvm .pyenv snap .var
  .docker .minikube .mozilla
  '**/.local/share' '**/.local/lib' '**/.local/state' '**/.kube/cache'
  '**/.config/google-chrome' '**/.config/chromium' '**/.config/Code' '**/.config/JetBrains'
  # macOS
  Library .Trash .DS_Store
  # Binary and media files
  '*.{class,jar,o,so,a,pyc,lock,log,swp}'
  '*.{png,jpg,jpeg,gif,webp,svg,heic,mp4,mkv,mov,mp3,m4a,wav}'
  '*.{zip,tar,gz,iso,pdf,woff,woff2}'
  .codex .antigravity-ide .vscode .gemini .cagent '**/.tmux/plugins'
  Pictures Music Movies
)

# no search path for ff . so fd prints paths relative to the current dir
search=()
if [ "${1:-}" != "." ]; then
  search=(.)
  for r in "${ROOTS[@]}"; do [ -d "$r" ] && search+=("$r"); done
fi

args=(--type f --hidden --color never)
for e in "${EXCLUDES[@]}"; do args+=(--exclude "$e"); done

if [ -n "$BAT" ]; then
  preview="$BAT --color=always --style=numbers --line-range=:200 {}"
else
  preview="head -200 {}"
fi

# pipefail is off here so fd being stopped early by fzf is not treated as a failure.
# ${search[@]+...} because macOS bash 3.2 treats an empty array as unset under set -u.
set +o pipefail
"$FD" "${args[@]}" ${search[@]+"${search[@]}"} 2>/dev/null | fzf \
  --multi --height 70% --reverse --border \
  --prompt "$FILE_ICON " \
  --preview "$preview" \
  --preview-window 'right:55%' || true
